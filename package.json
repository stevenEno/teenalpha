{
    "name": "teen-alpha",
    "private": true,
    "packageManager": "npm@11.6.0",
    "workspaces": [
      "apps/*",
      "packages/*"
    ],
    "scripts": {
      "dev": "turbo run dev",
      "build": "turbo run build",
      "start": "turbo run start",
      "lint": "turbo run lint",
      "clean": "turbo run clean",
      "web": "turbo run dev --filter=web",
      "web:build": "turbo run build --filter=web",
      "web:start": "turbo run start --filter=web"
    },
    "devDependencies": {
      "turbo": "latest"
    }
  }